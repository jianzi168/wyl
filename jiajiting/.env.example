# 认证模式：local（本地开发）| cloud（对接后端 API）
VITE_AUTH_MODE=local

# 云端 API 根地址（cloud 模式必填）
VITE_API_BASE=https://your-api.example.com

# 微信小程序 AppID（也可在 manifest.json 配置）
VITE_WX_APPID=

# 订阅消息模板 ID（支付后提醒补记，微信公众平台配置后填入）
VITE_SUBSCRIBE_RECORD_TMPL=

# AI 模式：local（模板解读）| cloud（对接 /ai/coach API）
VITE_AI_MODE=local

# 联盟优惠模式：local（Mock 券）| cloud（对接 /alliance/coupons API）
VITE_ALLIANCE_MODE=local
